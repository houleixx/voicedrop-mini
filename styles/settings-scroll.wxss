.settings-scroll {
  height: 100%;
}

.settings-scroll-content {
  box-sizing: border-box;
  /* Keep a tiny scroll range so short pages retain the native rebound affordance. */
  min-height: calc(100% + 2px);
  padding: var(--settings-content-top) 32rpx 48rpx;
}

.settings-scroll-content .page-body,
.settings-scroll-content .settings-content {
  padding: 0 !important;
}

<view class="screen settings-screen">
  <page-header title="微信公众号" />
  <view class="page-body">
    <view wx:if="{{loading}}" class="status-loading">
      <view class="loading-spinner" aria-hidden="true"></view>
      <text>正在检查连接状态...</text>
    </view>

    <block wx:else>
      <view class="hero-icon {{connected ? 'hero-icon-connected' : ''}}">
        <text class="{{connected ? 'ri-check-line' : 'ri-send-plane-line'}}"></text>
      </view>
      <text class="status-title">{{connected ? '已连接微信公众号' : '未连接微信公众号'}}</text>
      <text class="status-detail">{{connected ? '授权成功，现在可以将文章保存或更新到公众号草稿箱。' : '连接后，VoiceDrop 可以将文章保存到你的公众号草稿箱。不会自动群发。'}}</text>

      <view wx:if="{{connected}}" class="account-card">
        <text class="account-label">已授权账号</text>
        <text class="account-name">{{accountName || '微信公众号'}}</text>
        <text class="account-meta">草稿箱已就绪 · VoiceDrop 不会自动群发</text>
      </view>

      <button wx:if="{{!connected}}" class="primary-button" disabled="{{connecting}}" loading="{{connecting}}" bindtap="connectWechat">生成并复制授权链接</button>
      <button wx:else class="disconnect-button" disabled="{{disconnecting}}" loading="{{disconnecting}}" bindtap="disconnectWechat">取消连接</button>

      <view wx:if="{{!connected}}" class="steps-card">
        <text class="steps-title">连接方法</text>
        <text class="steps-text">1. 点击“生成并复制授权链接”，链接会自动复制</text>
        <text class="steps-text">2. 任选一种方式打开链接</text>
        <view class="method-options">
          <view class="method-option">
            <text class="method-option-title">电脑打开</text>
            <text class="method-option-detail">复制链接至电脑浏览器打开，再用手机微信扫码</text>
          </view>
          <view class="method-option">
            <text class="method-option-title">手机打开</text>
            <text class="method-option-detail">复制链接至手机浏览器中打开，对页面进行截图，随后打开微信“扫一扫”，选择相册中的截图进行识别</text>
          </view>
        </view>
        <text class="steps-text">3. 选择要绑定的公众号并确认授权，然后返回 VoiceDrop</text>
      </view>
    </block>
  </view>
</view>

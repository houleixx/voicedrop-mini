@import '../../styles/remixicon.wxss';

.screen { padding: 0 32rpx; background: #faf7f3; }
.page-body { padding: 42rpx 8rpx 48rpx; text-align: center; }
.status-loading { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: #8a8175; font-size: 26rpx; }
.loading-spinner { width: 48rpx; height: 48rpx; border: 6rpx solid #eadfce; border-top-color: #c7432f; border-radius: 50%; animation: loading-spin .8s linear infinite; }
@keyframes loading-spin { to { transform: rotate(360deg); } }
.hero-icon { width: 112rpx; height: 112rpx; margin: 18rpx auto 24rpx; border-radius: 56rpx; display: flex; align-items: center; justify-content: center; background: #f6e5df; color: #d8593b; font-size: 56rpx; }
.hero-icon-connected { background: #5e8a6a; color: #fff; }
.status-title { display: block; color: #2a2521; font-size: 40rpx; font-weight: 900; }
.status-detail { display: block; max-width: 620rpx; margin: 20rpx auto 44rpx; color: #8a8175; font-size: 28rpx; line-height: 1.65; }
.account-card { display: flex; flex-direction: column; margin: 0 8rpx 36rpx; padding: 28rpx 32rpx; border: 1rpx solid #d3e4d7; border-radius: 28rpx; background: #f1f7f2; text-align: left; }
.account-label { color: #5e8a6a; font-size: 24rpx; font-weight: 800; }
.account-name { margin-top: 8rpx; color: #2a2521; font-size: 34rpx; font-weight: 900; }
.account-meta { margin-top: 10rpx; color: #8a8175; font-size: 25rpx; }
.primary-button, .disconnect-button { width: calc(100% - 16rpx); min-height: 100rpx; border-radius: 20rpx; font-size: 32rpx; font-weight: 900; line-height: 100rpx; }
.primary-button { background: #df5d49; color: #fff; border: none; }
.disconnect-button { background: transparent; color: #8a8175; border: 1rpx solid #ded6ca; }
.primary-button::after, .disconnect-button::after { border: none; }
.steps-card { display: flex; flex-direction: column; gap: 14rpx; margin: 34rpx -8rpx 0; padding: 28rpx 30rpx; border: 2rpx solid #ece3d5; border-radius: 24rpx; background: #fff; text-align: left; }
.steps-title { margin-bottom: 4rpx; color: #2a2521; font-size: 28rpx; font-weight: 900; }
.steps-text { color: #8a8175; font-size: 25rpx; line-height: 1.55; }
.method-options { display: flex; flex-direction: column; gap: 12rpx; margin: 0 0 2rpx 30rpx; }
.method-option { padding: 18rpx 20rpx; border-radius: 16rpx; background: #faf7f3; }
.method-option-title { display: block; color: #5f574f; font-size: 25rpx; font-weight: 800; }
.method-option-detail { display: block; margin-top: 6rpx; color: #8a8175; font-size: 24rpx; line-height: 1.5; }

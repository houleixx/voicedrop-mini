<import src="../../utils/book-shelf-controls.wxml" />
<view class="screen shelf-page">
  <home-tabs language-revision="{{languageRevision}}" current="books" tabs="{{tabs}}" bind:change="switchTab" bind:settings="openSettings" />
  <scroll-view class="shelf-scroll" scroll-y enhanced bounces refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh">
    <template is="book-shelf-controls" data="{{filterBaselineClass, bookFilter, bookSearching, bookFilters, bookQuery, bookHasQuery, bookSearchError, bookSearchLoading, i18n}}" />
    <view wx:if="{{error && !items.length}}" class="shelf-state">{{error}}</view>
    <view wx:elif="{{loading && !items.length}}" class="shelf-state">{{i18n["正在整理书架…"]}}</view>
    <view wx:if="{{!loading && !error && bookEmptyText}}" class="book-shelf-empty">{{bookEmptyText}}</view>
    <view class="shelf-grid">
      <view wx:if="{{!bookHasQuery}}" class="shelf-cell write-cell" bindtap="writeBook">
        <view class="book-cover write-cover"><view class="write-plus">＋</view><text>{{i18n["写书"]}}</text></view>
        <text class="book-caption">{{i18n["写一本新书"]}}</text>
      </view>
      <view class="shelf-cell" wx:for="{{visibleBooks}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="openBook">
        <view class="book-cover cloth" style="background: linear-gradient(145deg, {{item.c}}, {{item.c2}});">
          <text class="cover-main">{{item.main}}</text><view class="cover-rule"></view><text class="cover-sub">{{item.sub}}</text>
          <image wx:if="{{item.coverDisplayUrl}}" class="cover-image" src="{{item.coverDisplayUrl}}" mode="aspectFill" data-slug="{{item.slug}}" binderror="onBookCoverError" />
          <text wx:if="{{item.hidden}}" class="book-hidden-badge">{{i18n["隐藏"]}}</text>
        </view>
        <text class="book-caption">{{item.main}}</text>
        <text class="book-meta {{item.chapterHit ? 'book-chapter-hit' : ''}}">{{item.chapterHit || item.shelfMeta}}</text>
      </view>
    </view>
  </scroll-view>
</view>

<view class="screen settings-screen language-settings-page" style="height: 100vh; padding: 0; overflow: hidden;">
  <page-header language-revision="{{languageRevision}}" title="{{labels.title}}" />
  <scroll-view class="settings-scroll" scroll-y enhanced bounces="{{true}}" show-scrollbar="{{false}}"><view class="settings-scroll-content"><view class="page-body">
    <text class="language-hint">{{labels.hint}}</text>
    <view class="card language-card">
      <radio-group bindchange="selectLanguage">
        <label class="language-option">
          <text class="language-option-copy">{{labels.followSystem}}</text>
          <radio value="" checked="{{selectedLanguage === ''}}" color="#c7432f" />
        </label>
        <label class="language-option">
          <text class="language-option-copy">{{labels.simplifiedChinese}}</text>
          <radio value="zh-Hans" checked="{{selectedLanguage === 'zh-Hans'}}" color="#c7432f" />
        </label>
        <label class="language-option no-border">
          <text class="language-option-copy">{{labels.english}}</text>
          <radio value="en" checked="{{selectedLanguage === 'en'}}" color="#c7432f" />
        </label>
      </radio-group>
    </view>
    <button class="language-done" bindtap="applyLanguage">{{labels.done}}</button>
  </view></view></scroll-view>
</view>

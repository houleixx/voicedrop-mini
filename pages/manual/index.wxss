.manual-page {
  min-height: 100vh;
  background: #faf6ef;
}

.manual-shell {
  position: fixed;
  top: 198rpx;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: #faf6ef;
}

.manual-tabs {
  width: 100%;
  height: 70rpx;
  flex-shrink: 0;
  background: rgba(250, 246, 239, 0.98);
  white-space: nowrap;
}

.manual-tabs-inner {
  display: inline-flex;
  padding: 0rpx 22rpx 12rpx;
  gap: 12rpx;
}

.manual-tab {
  display: flex;
  width: 115rpx;
  height: 52rpx;
  flex: 0 0 115rpx;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e5dacb;
  border-radius: 26rpx;
  color: #756f66;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.manual-tab.active {
  border-color: #d8593b;
  color: #ffffff;
  background: #d8593b;
}

.manual-content {
  min-height: 0;
  flex: 1;
}

.manual-section {
  margin: 20rpx 22rpx 0;
  padding: 26rpx;
  border: 2rpx solid #ece3d5;
  border-radius: 24rpx;
  background: #ffffff;
  scroll-margin-top: 16rpx;
}

.manual-rich {
  display: block;
  overflow-wrap: anywhere;
  color: #4e4740;
  font-size: 27rpx;
  line-height: 1.72;
}

.manual-status {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  color: #91887d;
  font-size: 27rpx;
  text-align: center;
}

.manual-error {
  color: #8f766b;
}

.manual-spinner {
  width: 38rpx;
  height: 38rpx;
  border: 5rpx solid #eadfd2;
  border-top-color: #d8593b;
  border-radius: 50%;
  animation: manual-spin 0.8s linear infinite;
}

.manual-bottom-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

@keyframes manual-spin {
  to { transform: rotate(360deg); }
}

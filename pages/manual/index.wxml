<view class="manual-page">
  <page-header title="使用手册" />
  <view class="manual-shell">
    <scroll-view class="manual-tabs" scroll-x enhanced bounces="{{true}}" show-scrollbar="{{false}}">
      <view class="manual-tabs-inner">
        <view wx:for="{{sections}}" wx:key="id" class="manual-tab {{activeSection === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="jumpToSection">{{item.label}}</view>
      </view>
    </scroll-view>

    <scroll-view class="manual-content" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation enhanced bounces="{{true}}" show-scrollbar="{{false}}">
      <view wx:if="{{error}}" class="manual-status manual-error"><text>{{error}}</text><text>{{i18n["请重新打开小程序"]}}</text></view>
      <block wx:else>
        <view wx:for="{{chapters}}" wx:key="id" id="{{item.id}}" class="manual-section" data-id="{{item.id}}" bindappear="onSectionVisible">
          <rich-text class="manual-rich" nodes="{{item.html}}"></rich-text>
        </view>
      </block>
      <view class="manual-bottom-space"></view>
    </scroll-view>
  </view>
</view>

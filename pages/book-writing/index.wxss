@import '../../styles/remixicon.wxss';

.book-writing-page {
  position: relative;
  height: 100vh;
  padding: 0;
  overflow: hidden;
  background: #faf6ef;
  color: #2a2521;
}

.writing-scroll {
  position: fixed;
  top: 198rpx;
  right: 0;
  bottom: calc(206rpx + env(safe-area-inset-bottom));
  left: 0;
}

.writing-body {
  display: flex;
  padding: 8rpx 40rpx 60rpx;
  flex-direction: column;
  gap: 36rpx;
}

.price-card {
  display: flex;
  min-height: 174rpx;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border: 2rpx solid #ebd9b8;
  border-radius: 24rpx;
  background: #fff0d2;
}

.price-main {
  min-width: 0;
  flex: 1;
}

.price {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.price-copy {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bolt {
  display: inline-flex;
  width: 44rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  color: #c98a22;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.amount {
  color: #2a2521;
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1;
}

.price-unit {
  color: #81776a;
  font-size: 30rpx;
  font-weight: 600;
}

.price-note,
.section-copy,
.step-copy,
.earn-sub,
.bottom-hint {
  display: block;
  color: #81776a;
}

.price-note {
  margin-top: 8rpx;
  color: #b8ae9e;
  font-size: 25rpx;
  line-height: 1.4;
}

.balance {
  min-width: 190rpx;
  margin-left: 20rpx;
  text-align: right;
}

.balance-value {
  display: block;
  color: #4f8561;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
}

.balance-value.short,
.gap {
  color: #c64232;
}

.balance-label,
.balance-loading {
  display: block;
  margin-top: 6rpx;
  color: #b8ae9e;
  font-size: 25rpx;
  line-height: 1.3;
}

.earn-section,
.seed-section,
.pipeline-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  display: block;
  color: #9b9388;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.25;
}

.section-copy {
  margin-top: -2rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.feature-editor {
  box-sizing: border-box;
  width: 100%;
  height: 316rpx;
  padding: 30rpx;
  border: 3rpx solid #d8593b;
  border-radius: 24rpx;
  background: #fffdf9;
  color: #2a2521;
  box-shadow: 0 4rpx 14rpx rgba(216, 89, 59, 0.06);
  font-size: 30rpx;
  line-height: 1.45;
}

.book-placeholder {
  color: #b8ae9e;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.45;
}

.pipeline {
  overflow: hidden;
  border: 2rpx solid #eadfd2;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(65, 52, 41, 0.05);
}

.step {
  position: relative;
  display: flex;
  box-sizing: border-box;
  min-height: 100rpx;
  align-items: center;
  gap: 26rpx;
  padding: 20rpx 30rpx;
}

.step + .step {
  border-top: 0;
}

.step + .step::before {
  position: absolute;
  top: 0;
  right: 30rpx;
  left: 116rpx;
  height: 2rpx;
  background: #efe5d8;
  content: '';
}

.num {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #d8593b;
  background: #fae4dd;
  font-size: 30rpx;
  font-weight: 800;
}

.step-content {
  min-width: 0;
  flex: 1;
}

.step-title,
.earn-title {
  display: block;
  color: #2a2521;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
}

.step-copy,
.earn-sub {
  margin-top: 4rpx;
  font-size: 25rpx;
  line-height: 1.4;
}

.earn-card {
  padding: 26rpx 28rpx 28rpx;
  border: 2rpx solid #eadfd2;
  border-radius: 24rpx;
  background: #fffdf9;
  box-shadow: 0 4rpx 16rpx rgba(65, 52, 41, 0.04);
}

.earn-summary {
  display: block;
}

.gap {
  display: block;
  padding: 0;
  background: transparent;
  color: #2a2521;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.earn-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 0;
}

.earn-row + .earn-row {
  margin-top: 26rpx;
  border-top: 0;
}

.earn-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #c98a22;
  background: #fff0d2;
  font-size: 38rpx;
  line-height: 1;
}

.earn-icon-invite {
  color: #ee4c35;
  background: #fbe2db;
}

.earn-content {
  min-width: 0;
  flex: 1;
}

.earn-headline {
  line-height: 1.35;
}

.earn-title,
.earn-reward {
  display: inline;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.earn-reward {
  margin: 0;
  color: #2a2521;
}

.earn-sub {
  margin-top: 4rpx;
  font-size: 25rpx;
  line-height: 1.45;
}

.invite {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  margin-top: 24rpx;
  margin-right: 0;
  margin-left: 0;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #ffffff;
  background: #d8593b;
  font-size: 28rpx;
  font-weight: 600;
}

.feature-hint {
  display: block;
  color: #d64532;
  font-size: 26rpx;
  line-height: 1.5;
}

.writing-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 24rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #eadfd2;
  background: #faf6ef;
}

.feature-primary,
.done {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #ffffff;
  background: #d8593b;
  box-shadow: 0 8rpx 18rpx rgba(216, 89, 59, 0.14);
  font-size: 32rpx;
  font-weight: 600;
}

.feature-primary {
  margin: 0;
  padding: 0 20rpx;
  font-size: 30rpx;
  line-height: 1;
  white-space: nowrap;
}

.feature-primary[disabled] {
  color: #ffffff;
  background: #b8ae9e;
  box-shadow: none;
  opacity: 1;
}

.bottom-hint {
  margin-top: 18rpx;
  color: #b8ae9e;
  font-size: 25rpx;
  line-height: 1.35;
  text-align: center;
}

.submitted {
  display: flex;
  padding-top: 246rpx;
  padding-right: 50rpx;
  padding-left: 50rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.submitted-check {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #4f8561;
  font-size: 50rpx;
}

.submitted-title {
  margin-top: 24rpx;
  color: #2a2521;
  font-size: 34rpx;
  font-weight: 600;
}

.submitted-copy {
  margin: 24rpx 0 36rpx;
  color: #81776a;
  font-size: 28rpx;
  line-height: 1.6;
}

.done {
  width: 260rpx;
  height: 88rpx;
  margin: 0 auto;
  padding: 0 20rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
}

@import '../../styles/remixicon.wxss';

.book-writing-page {
  --settings-content-top: 198rpx;
}

.book-writing-body {
  padding-bottom: 48rpx;
}

.book-intro,
.book-note {
  display: block;
  color: #756f66;
  font-size: 28rpx;
  line-height: 1.55;
}

.book-note {
  margin-top: 22rpx;
  color: #aaa195;
}

.shelf-link {
  display: flex;
  min-height: 124rpx;
  margin: 24rpx 0;
  padding: 20rpx 22rpx 20rpx 26rpx;
  align-items: center;
  border: 2rpx solid #ece3d5;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 10rpx rgba(84, 68, 50, 0.06);
}

.shelf-link:active {
  background: #fffaf3;
}

.shelf-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #7f786f;
  background: #f2eee7;
  font-size: 42rpx;
}

.shelf-copy {
  display: flex;
  min-width: 0;
  margin-left: 24rpx;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.shelf-title {
  color: #2a2521;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.shelf-subtitle {
  overflow: hidden;
  color: #8f877d;
  font-size: 24rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shelf-chevron {
  margin-left: 12rpx;
  color: #c6bcae;
  font-size: 44rpx;
}

.feature-editor {
  box-sizing: border-box;
  width: 100%;
  height: 356rpx;
  padding: 15rpx;
  border: 2rpx solid #d8593b;
  border-radius: 18rpx;
  color: #2a2521;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.55;
}

.book-placeholder {
  color: #aaa195;
}

.feature-hint {
  display: block;
  margin: 20rpx 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.feature-hint.error { color: #d64532; }
.feature-hint.success { color: #4f8561; }

.feature-primary {
  display: flex;
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #ffffff;
  background: #d8593b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.feature-primary[disabled] {
  color: #ffffff;
  background: #d8cfc3;
}

.feature-loading {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: book-spin 0.8s linear infinite;
}

@keyframes book-spin {
  to { transform: rotate(360deg); }
}

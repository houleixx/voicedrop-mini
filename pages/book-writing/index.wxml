<view class="screen book-writing-page">
  <page-header language-revision="{{languageRevision}}" title="写书" />
  <block wx:if="{{submitted}}">
    <view class="submitted"><view class="submitted-check">✓</view><text class="submitted-title">{{i18n["开始写了！"]}}</text><text class="submitted-copy">{{i18n["现在可以关掉小程序。书通常 10–30 分钟写完，过稿一章、上架一章——写好就出现在「写书」书架上，下拉刷新就能看到。"]}}</text><button class="done" bindtap="done">{{i18n["好"]}}</button></view>
  </block>
  <block wx:else>
  <scroll-view class="writing-scroll" scroll-y enhanced bounces>
    <view class="writing-body">
      <view class="ai-generated-notice" role="note" aria-label="{{i18n['AI生成内容说明']}}">
        <text class="ai-generated-badge">{{i18n["AI生成"]}}</text>
        <text class="ai-generated-copy">{{i18n["本功能使用人工智能生成书籍内容"]}}</text>
      </view>
      <view class="price-card">
        <view class="price-main"><view class="price"><text class="bolt ri-flashlight-line"></text><view class="price-copy"><text class="amount">{{price}}</text><text class="price-unit">{{i18n["算力"]}}</text></view></view><text class="price-note">{{i18n["写一本书的价钱，提交时一次扣清"]}}</text></view>
        <view class="balance"><text wx:if="{{balance === null}}" class="balance-loading">{{i18n["加载中…"]}}</text><block wx:else><text class="balance-value {{balance < price ? 'short' : ''}}">{{balanceDisplay}}</text><text class="balance-label">{{i18n["你现在的算力"]}}</text></block></view>
      </view>
      <view wx:if="{{balance !== null && balance < price}}" class="earn-section">
        <text class="section-title">{{i18n["算力不够？"]}}</text>
        <view class="earn-card"><view class="earn-summary"><text class="gap">{{i18n["还差 "]}}{{shortfall}}{{i18n[" 算力，两条来路："]}}</text></view>
          <view class="earn-row"><text class="earn-icon earn-icon-feed ri-flashlight-line"></text><view class="earn-content"><view class="earn-headline"><text class="earn-title">{{i18n["请朋友给你的文章「加油」——"]}}</text><text class="earn-reward">{{i18n["一次约得 "]}}{{invite.suanliFeedAuthor || 0}}{{i18n[" 算力"]}}</text></view><text class="earn-sub">{{i18n["把文章分享到 VD社区或发给朋友，读的人点「加油」你就进账"]}}</text></view></view>
          <view class="earn-row"><text class="earn-icon earn-icon-invite ri-group-line"></text><view class="earn-content"><view class="earn-headline"><text class="earn-title">{{i18n["邀请朋友装 VoiceDrop——"]}}</text><text class="earn-reward">{{i18n["装一个约得 "]}}{{invite.suanliInviter || 0}}{{i18n[" 算力"]}}</text></view><text class="earn-sub">{{i18n["朋友通过你的链接安装，双方都到账"]}}</text></view></view>
          <button wx:if="{{invite.url}}" class="invite" bindtap="shareInvite">{{i18n["把邀请链接发给朋友"]}}</button>
        </view>
      </view>
      <view class="seed-section"><text class="section-title">{{i18n[seedTitleKey]}}</text><block wx:if="{{seedArticle}}"><view class="article-seed-card"><text class="article-seed-title">《{{seedArticle.title}}》{{i18n["已作为种子"]}}</text><text class="article-seed-preview">{{seedArticle.body}}</text></view><text class="section-copy">{{i18n["可以补充这本书往哪儿写：比如“写成给孩子的绘本”“扩成一本科普书”“沿着文中第三点展开”。不填就由写书代理自己定。"]}}</text></block><text wx:else class="section-copy">{{i18n["一句话说清这本书要讲明白的那一个问题或主张。想法越聚焦，书越好看；也可以贴一整篇文章当种子。"]}}</text><textarea class="feature-editor" maxlength="20000" value="{{seed}}" bindinput="onInput" placeholder="{{i18n[seedPlaceholderKey]}}" placeholder-class="book-placeholder" /></view>
      <view class="book-options">
        <view class="author-row"><text class="option-title">{{i18n["作者"]}}</text><input class="author-input" aria-label="{{i18n['作者']}}" value="{{author}}" bindinput="onAuthorInput" maxlength="-1" disabled="{{sending}}" placeholder="{{i18n['留空则不署名']}}" /></view>
        <text class="author-hint">{{i18n["修改作者也会同步修改设置中的名字。"]}}</text>
        <text wx:if="{{authorLoading}}" class="author-hint">{{i18n["正在读取作者名字…"]}}</text>
        <text wx:elif="{{loadedName === null}}" class="author-hint">{{i18n["名字未能加载，提交前会重试；也可以填写作者。"]}}</text>
        <view class="hidden-row"><view class="hidden-copy"><text class="option-title">{{i18n["隐藏"]}}</text><text class="option-copy">{{i18n["不上公开书架，已有链接仍可阅读；以后可在书页菜单修改。"]}}</text></view><switch color="#d8593b" checked="{{hidden}}" disabled="{{sending}}" bindchange="onHiddenChange" aria-label="{{i18n['隐藏']}}" /></view>
      </view>
      <text wx:if="{{message}}" class="feature-hint error">{{message}}</text>
    </view>
  </scroll-view>
  <view class="writing-bottom"><button class="feature-primary" bindtap="start" disabled="{{!canSubmit}}">{{sending ? i18n['提交中…'] : (shortfall > 0 ? i18n['算力不够 · 还差 '] + shortfall : i18n['开始写书 · '] + price + i18n[' 算力'])}}</button><text class="bottom-hint">{{i18n["AI生成 · 提交后可关闭小程序，10–30 分钟写完并出现在「写书」书架"]}}</text></view>
  </block>
</view>

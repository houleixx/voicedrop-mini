<view class="screen settings-screen about-page">
  <page-header title="关于" />
  <view class="page-body">
    <view class="about-card card">
      <text class="logo">VoiceDrop 口述</text>
      <text class="desc">把口述录音自动变成文章的小程序客户端。</text>
      <text class="version">当前版本 {{appVersion}}</text>
    </view>

    <view class="card menu">
      <view class="row" bindtap="privacy">
        <text>隐私说明</text>
        <text class="muted">查看</text>
      </view>
      <view class="row" bindtap="openAudioConsent">
        <text>音频信息授权协议</text>
        <text class="muted">{{audioConsentGranted ? '已授权' : '未授权'}}</text>
      </view>
      <view class="row" bindtap="communityTerms">
        <text>社区公约</text>
        <text class="muted">查看</text>
      </view>
      <view class="row blocked-entry" bindtap="openBlockedUsers">
        <text>已屏蔽用户</text>
        <view class="row-action">
          <text class="muted">{{blockedAuthors.length}} 人</text>
          <text class="about-arrow ri-arrow-right-s-line" aria-hidden="true"></text>
        </view>
      </view>
      <view class="row" bindtap="copyEmail">
        <text>支持与投诉</text>
        <text class="muted">{{supportEmail}}</text>
      </view>
    </view>
  </view>
</view>

@import '../../styles/remixicon.wxss';

.about-page {
  --settings-content-top: 198rpx;
}

.about-card,
.menu {
  border: 2rpx solid #ece3d5;
  background: #ffffff;
}

.about-card {
  margin-top: 0;
  padding: 32rpx;
}

.logo {
  display: block;
  color: #2a2521;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.desc {
  display: block;
  margin-top: 10rpx;
  color: #756f66;
  font-size: 26rpx;
  line-height: 1.5;
}

.version {
  display: block;
  margin-top: 12rpx;
  color: #756f66;
  font-size: 24rpx;
  line-height: 1.4;
}

.menu {
  margin-top: 0;
  overflow: hidden;
}

.menu .row {
  position: relative;
  min-height: 120rpx;
  padding: 20rpx 28rpx;
  justify-content: flex-start;
  border-bottom: 0;
}

.menu .row::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 124rpx;
  height: 1rpx;
  background: #f0e8da;
  content: '';
}

.menu .row:last-child::after {
  display: none;
}

.about-menu-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f6e4dc;
}

.about-menu-icon-glyph {
  display: block;
  width: 38rpx;
  height: 38rpx;
  color: #d8593b;
  font-size: 38rpx;
  line-height: 38rpx;
  text-align: center;
}

.about-menu-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.about-menu-title {
  color: #2a2521;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

.about-menu-subtitle,
.about-menu-status {
  overflow: hidden;
  color: #756f66;
  font-size: 24rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-action {
  display: flex;
  margin-left: 16rpx;
  flex-shrink: 0;
  align-items: center;
  gap: 6rpx;
}

.about-arrow {
  display: block;
  width: 36rpx;
  height: 36rpx;
  color: #9b8f7f;
  font-size: 36rpx;
  line-height: 36rpx;
  text-align: center;
  vertical-align: 0;
}

.blocked-entry:active {
  background: #fff8ef;
}

.section-label { display: block; margin: 28rpx 8rpx 10rpx; color: #756f66; font-size: 24rpx; font-weight: 700; }
.experimental-menu { margin-top: 0; }

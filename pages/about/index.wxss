@import '../../styles/remixicon.wxss';

.about-page {
  --settings-content-top: 198rpx;
}

.about-card,
.menu {
  border: 2rpx solid #ece3d5;
  background: #ffffff;
}

.about-card {
  margin-top: 0;
  padding: 32rpx;
}

.logo {
  display: block;
  color: #2a2521;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.desc {
  display: block;
  margin-top: 10rpx;
  color: #756f66;
  font-size: 26rpx;
  line-height: 1.5;
}

.version {
  display: block;
  margin-top: 12rpx;
  color: #756f66;
  font-size: 24rpx;
  line-height: 1.4;
}

.menu {
  margin-top: 16rpx;
  overflow: hidden;
}

.menu .row {
  min-height: 104rpx;
  padding: 20rpx 28rpx;
}

.menu .row > text:first-child {
  color: #2a2521;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.about-page .muted {
  max-width: 54%;
  margin-left: 20rpx;
  color: #756f66;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: right;
  word-break: break-all;
}

.row-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: 20rpx;
}

.about-arrow {
  display: block;
  width: 36rpx;
  height: 36rpx;
  color: #9b8f7f;
  font-size: 36rpx;
  line-height: 36rpx;
  text-align: center;
  vertical-align: 0;
}

.blocked-entry:active {
  background: #fff8ef;
}

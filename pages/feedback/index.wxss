.feedback-page {
  --settings-content-top: 198rpx;
}

.feedback-body {
  padding-bottom: 48rpx;
}

.feature-editor-card {
  box-sizing: border-box;
  overflow: hidden;
  border: 2rpx solid #ded5c8;
  border-radius: 28rpx;
  background: #ffffff;
}

.feature-editor-placeholder {
  color: #aaa195;
}

.feature-editor {
  box-sizing: border-box;
  width: 100%;
  height: 320rpx;
  padding: 28rpx 28rpx 12rpx;
  color: #2a2521;
  background: transparent;
  font-size: 30rpx;
  line-height: 1.5;
}

.feature-count {
  display: block;
  padding: 0 28rpx 20rpx;
  color: #9b9286;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: right;
}

.feature-hint {
  display: block;
  min-height: 34rpx;
  margin: 20rpx 4rpx;
  color: #756f66;
  font-size: 24rpx;
  line-height: 34rpx;
}

.feature-hint.error {
  color: #d64532;
}

.feature-primary {
  display: flex;
  width: 100%;
  height: 92rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 28rpx;
  color: #ffffff;
  background: #d8593b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.feature-primary[disabled] {
  color: #ffffff;
  background: #d8cfc3;
}

.feature-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.feature-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: feedback-spin 0.8s linear infinite;
}

@keyframes feedback-spin {
  to { transform: rotate(360deg); }
}

.reader {
  min-height: 100vh;
  background: #fcf6eb;
}

.reader-actions {
  position: fixed;
  top: 38rpx;
  right: 30rpx;
  z-index: 20;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(42, 37, 33, 0.72);
  color: #fff;
  font-size: 44rpx;
  line-height: 48rpx;
  text-align: center;
}

.reader-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fcf6eb;
}

.reader-loading-card {
  position: fixed;
  top: 42%;
  left: 50%;
  display: flex;
  width: 220rpx;
  height: 220rpx;
  transform: translate(-50%, -50%);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.68);
}

.reader-loading-spinner {
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 26rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.32);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: reader-loading-spin 0.8s linear infinite;
}

.reader-loading-copy {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

@keyframes reader-loading-spin {
  to { transform: rotate(360deg); }
}

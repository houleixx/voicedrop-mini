.reader {
  min-height: 100vh;
  background: #faf6ef;
}

.reader-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.reader-loading-card {
  display: flex;
  width: 220rpx;
  height: 220rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.68);
}

.reader-loading-spinner {
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 26rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.32);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: reader-loading-spin 0.8s linear infinite;
}

.reader-loading-copy {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

@keyframes reader-loading-spin {
  to { transform: rotate(360deg); }
}

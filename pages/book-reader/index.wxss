.reader {
  min-height: 100vh;
  background: #fcf6eb;
}

.reader-actions, .reader-web-actions {
  box-sizing: border-box;
  display: flex;
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: rgba(42, 37, 33, 0.72);
  color: #fff;
  font-size: 36rpx;
  line-height: 64rpx;
  text-align: center;
}
.reader-web-actions { position: fixed; top: 5rpx; right: 20rpx; z-index: 20; }
.reader-actions { position: absolute; top: calc(100% - 19rpx); right: 20rpx; z-index: 103; }
.reader-offline-backdrop { z-index: 101; }
.reader-offline-menu .reader-menu-card { position: absolute; top: calc(100% + 58rpx); right: 20rpx; }

.reader-menu-layer {
  position: fixed;
  inset: 0;
  z-index: 19;
  background: transparent;
}

.reader-menu-card {
  position: fixed;
  top: 82rpx;
  right: 20rpx;
  width: 360rpx;
  overflow: hidden;
  border: 1rpx solid rgba(220, 210, 196, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 44rpx rgba(65, 52, 41, 0.16);
}

.reader-menu-row {
  position: relative;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 30rpx;
  color: #2a2521;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.reader-menu-separator {
  height: 1rpx;
  margin: 0 30rpx;
  background: rgba(222, 214, 202, 0.82);
}

.reader-menu-row-danger { color: #d8593b; }

.reader-opening {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: calc(env(safe-area-inset-top) + 100rpx) 36rpx 0;
  color: #74685b;
  font-size: 28rpx;
}

.reader-opening-title {
  color: #2a2521;
  font-size: 36rpx;
  font-weight: 600;
}

.reader-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fcf6eb;
}

.reader-loading-card {
  position: fixed;
  top: 42%;
  left: 50%;
  display: flex;
  width: 220rpx;
  height: 220rpx;
  transform: translate(-50%, -50%);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.68);
}

.reader-loading-spinner {
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 26rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.32);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: reader-loading-spin 0.8s linear infinite;
}

.reader-loading-copy {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

@keyframes reader-loading-spin {
  to { transform: rotate(360deg); }
}

.offline-reader {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: #faf6ef;
  color: #2a2521;
}
.reader-offline-scroll { flex: 1; height: 0; min-height: 0; }
.reader-offline-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #746a60;
  font-size: 28rpx;
}
.reader-offline-loading .reader-loading-spinner {
  border-color: #e9d8ce;
  border-top-color: #d8593b;
}
.offline-player, .offline-chapter-nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 0;
}
.offline-reader button { margin: 0; }
.offline-player slider { flex: 1; }
.offline-book-title { font-family: "Songti SC", "STSong", serif; font-size: 48rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.offline-chapter-picker { padding: 18rpx 0; border-bottom: 1rpx solid #e0d8cc; }
.offline-block { font-size: 32rpx; line-height: 1.8; overflow-wrap: break-word; }
.offline-image, .offline-video { display: block; width: 100%; }
.offline-chapter-nav { justify-content: space-between; }

.offline-download-actions { display: flex; flex-wrap: wrap; gap: 16rpx; }

.offline-image { margin: 20rpx 0; border-radius: 10rpx; }
.reader-directory { margin: 44rpx 0 24rpx; }
.reader-directory-title { display: block; margin-bottom: 12rpx; color: #756553; font-size: 27rpx; }
.reader-directory .reader-chapter-link {
  width: 100%;
  border-radius: 0;
  border-bottom: 1rpx solid #e0d8cc;
  padding: 18rpx 8rpx;
  background: transparent;
  color: #422f23;
  font-size: 31rpx;
  line-height: 1.5;
  text-align: left;
}
.reader-chapter-link::after { border: 0; }
.reader-chapter-link text { float: right; color: #9b8066; }

.reader-paper { max-width: 720px; margin: 0 auto; padding: 0 44rpx calc(40rpx + env(safe-area-inset-bottom)); }
.reader-header-mode, .reader-chapter-kicker { color: #897d6e; font-size: 25rpx; }
.reader-chapter-heading { margin: 43rpx 0 26rpx; }
.reader-chapter-heading text { display: block; }
.offline-book-title { margin: 8rpx 0 0; line-height: 1.35; }
.offline-chapter-picker { color: #756553; font-size: 26rpx; }
.offline-block { font-size: 34rpx; line-height: 1.85; }

.reader-breadcrumb { display: flex; justify-content: space-between; margin: 62rpx 0 65rpx; color: #897d6e; font-size: 27rpx; }
.reader-dot { color: #7a8061; font-size: 18rpx; }
.reader-badge { display: inline-block; background: #e9ecdf; color: #526344; border-radius: 40rpx; padding: 4rpx 16rpx; font-size: 22rpx; }
.reader-index .offline-book-title, .reader-chapter-heading .offline-book-title { display: block; font-size: 62rpx; line-height: 1.35; }
.reader-index-sub, .reader-index-meta, .reader-intro text { display: block; }
.reader-index-sub { margin-top: 20rpx; color: #897d6e; font-size: 30rpx; line-height: 1.65; }
.reader-index-meta { margin-top: 28rpx; color: #897d6e; font-size: 24rpx; }
.reader-intro { border: 1rpx solid #e5d9c9; border-radius: 28rpx; background: #faf5eb; padding: 34rpx 38rpx; margin: 54rpx 0 62rpx; }
.reader-intro text:first-child { font-size: 32rpx; font-weight: 600; }
.reader-intro text + text { color: #897d6e; font-size: 27rpx; line-height: 1.75; margin-top: 12rpx; }
.reader-directory-row { display: flex; gap: 24rpx; align-items: baseline; padding: 26rpx 4rpx; border-bottom: 1rpx solid #e0d8cc; }
.reader-directory-number { color: #697453; width: 44rpx; font-size: 29rpx; }
.reader-directory-copy { flex: 1; font-size: 32rpx; font-weight: 500; }
.reader-directory-brief { display: block; margin-top: 9rpx; color: #897d6e; font-size: 26rpx; line-height: 1.65; font-weight: 400; }
.reader-directory-read { white-space: nowrap; color: #897d6e; font-size: 23rpx; }
.reader-chapter-heading { margin-top: 0; }

.reader-web-progress {
  position: fixed;
  z-index: 18;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  pointer-events: none;
}
.reader-web-progress .reader-progress-track,
.reader-web-progress .reader-progress-fill {
  border-radius: 0;
}
.reader-title-bar { position: relative; flex: none; z-index: 102; background: #faf6ef; }
.reader-progress-slot { height: 6rpx; padding: 0 40rpx; }
.reader-progress-track {
  width: 100%;
  height: 6rpx;
  overflow: hidden;
  border-radius: 3rpx;
  background: #f6e4dc;
}
.reader-progress-fill {
  height: 6rpx;
  border-radius: 3rpx;
  background: #d8593b;
}

.reader-directory .reader-chapter-pressed {
  background: var(--reader-chapter-tint, #f0e6d4);
  border-radius: 20rpx;
}

.reader {
  min-height: 100vh;
  background: #fcf6eb;
}

.reader-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fcf6eb;
}

.reader-more {
  position: fixed;
  z-index: 20;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e7ded2;
  border-radius: 18rpx;
  background: rgba(255, 253, 249, 0.96);
  box-shadow: 0 6rpx 18rpx rgba(65, 52, 41, 0.14);
}

.reader-more-dots {
  color: #756d63;
  background: transparent;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1;
}

.reader-loading-card {
  display: flex;
  width: 220rpx;
  height: 220rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.68);
}

.reader-loading-spinner {
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 26rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.32);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: reader-loading-spin 0.8s linear infinite;
}

.reader-loading-copy {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

@keyframes reader-loading-spin {
  to { transform: rotate(360deg); }
}

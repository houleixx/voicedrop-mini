<web-view wx:if="{{readerReady && url}}" src="{{url}}" bindload="onWebLoad" binderror="onWebError"></web-view>
<cover-view wx:if="{{readerReady && url && !loading}}" class="reader-web-actions" bindtap="openActions" aria-label="{{i18n['书籍操作']}}">⋯</cover-view>
<cover-view wx:if="{{url && offlineProgress >= 0}}" class="reader-web-progress" aria-label="下载进度 {{offlineProgress}}%">
  <cover-view class="reader-progress-track">
    <cover-view class="reader-progress-fill" style="width: {{offlineProgress}}%;"></cover-view>
  </cover-view>
</cover-view>
<cover-view wx:if="{{url && moreMenuOpen}}" class="reader-menu-layer" bindtap="closeMoreMenu">
  <cover-view class="reader-menu-card" catchtap="noop">
    <cover-view wx:if="{{mine}}" class="reader-menu-row" data-action="revise" bindtap="runMoreMenuAction">修改这本书</cover-view>
    <cover-view wx:if="{{mine}}" class="reader-menu-separator"></cover-view>
    <cover-view wx:if="{{mine}}" class="reader-menu-row reader-menu-row-danger" data-action="visibility" bindtap="runMoreMenuAction">{{hidden ? '取消隐藏本书' : '隐藏本书'}}</cover-view>
    <cover-view wx:if="{{mine}}" class="reader-menu-separator"></cover-view>
    <cover-view class="reader-menu-row" data-action="offline-download" bindtap="runMoreMenuAction">{{offlineProgress >= 0 ? '正在下载 ' + offlineProgress + '%' : (offlineAvailable ? '重新下载' : '下载到本地')}}</cover-view>
    <cover-view wx:if="{{offlineAvailable}}" class="reader-menu-separator"></cover-view>
    <cover-view wx:if="{{offlineAvailable}}" class="reader-menu-row" data-action="offline-toggle" bindtap="runMoreMenuAction">{{offline ? '在线阅读' : '查看本地副本'}}</cover-view>
    <cover-view wx:if="{{offlineAvailable}}" class="reader-menu-separator"></cover-view>
    <cover-view wx:if="{{offlineAvailable}}" class="reader-menu-row reader-menu-row-danger" data-action="offline-remove" bindtap="runMoreMenuAction">删除本地副本</cover-view>
  </cover-view>
</cover-view>
<view wx:if="{{offline}}" class="offline-reader">
  <view class="reader-title-bar">
    <page-header title="{{title}}" in-flow />
    <view class="reader-actions" bindtap="openActions" aria-label="{{i18n['书籍操作']}}">⋯</view>
  <view class="reader-progress-slot">
    <view wx:if="{{offlineProgress >= 0}}" class="reader-progress-track" aria-label="下载进度 {{offlineProgress}}%">
      <view class="reader-progress-fill" style="width: {{offlineProgress}}%;"></view>
    </view>
  </view>
    <view wx:if="{{!url && moreMenuOpen}}" class="reader-offline-menu">
  <view class="reader-menu-card" catchtap="noop">
    <view wx:if="{{mine}}" class="reader-menu-row" data-action="revise" bindtap="runMoreMenuAction">修改这本书</view>
    <view wx:if="{{mine}}" class="reader-menu-separator"></view>
    <view wx:if="{{mine}}" class="reader-menu-row reader-menu-row-danger" data-action="visibility" bindtap="runMoreMenuAction">{{hidden ? '取消隐藏本书' : '隐藏本书'}}</view>
    <view wx:if="{{mine}}" class="reader-menu-separator"></view>
    <view class="reader-menu-row" data-action="offline-download" bindtap="runMoreMenuAction">{{offlineProgress >= 0 ? '正在下载 ' + offlineProgress + '%' : (offlineAvailable ? '重新下载' : '下载到本地')}}</view>
    <view wx:if="{{offlineAvailable}}" class="reader-menu-separator"></view>
    <view wx:if="{{offlineAvailable}}" class="reader-menu-row" data-action="offline-toggle" bindtap="runMoreMenuAction">{{offline ? '在线阅读' : '查看本地副本'}}</view>
    <view wx:if="{{offlineAvailable}}" class="reader-menu-separator"></view>
    <view wx:if="{{offlineAvailable}}" class="reader-menu-row reader-menu-row-danger" data-action="offline-remove" bindtap="runMoreMenuAction">删除本地副本</view>
  </view>
</view>
  </view>
  <view wx:if="{{moreMenuOpen}}" class="reader-menu-layer reader-offline-backdrop" bindtap="closeMoreMenu"></view>
  <view wx:if="{{chapterLoading}}" class="reader-offline-loading" role="status">
    <view class="reader-loading-spinner"></view>
    <text>{{i18n["加载中…"]}}</text>
  </view>
  <scroll-view class="reader-offline-scroll" scroll-y enhanced bounces="{{true}}" show-scrollbar="{{false}}"
    scroll-into-view="{{chapterScrollTarget}}" hidden="{{chapterLoading}}">
  <view class="reader-paper" id="reader-chapter-start">
  <text class="reader-header-mode">离线阅读</text>
  <view wx:if="{{chapters.length}}" class="reader-breadcrumb">
    <text data-index="0" bindtap="openChapter"><text class="reader-dot">●</text> {{title}}</text>
    <text bindtap="goBack">书架</text>
  </view>
  <view wx:if="{{pageIndex}}" class="reader-index">
    <text wx:if="{{pageIndex.badge}}" class="reader-badge">{{pageIndex.badge}}</text>
    <text class="offline-book-title">{{pageIndex.title}}</text>
    <text wx:if="{{pageIndex.subtitle}}" class="reader-index-sub">{{pageIndex.subtitle}}</text>
    <text wx:if="{{pageIndex.meta}}" class="reader-index-meta">{{pageIndex.meta}}</text>
    <view wx:if="{{pageIndex.intro && pageIndex.introPosition >= 0}}" class="reader-intro" data-index="{{pageIndex.introPosition}}" bindtap="openChapter">
      <text>导读 · 从这里进门</text><text>{{pageIndex.intro}}</text>
    </view>
  </view>
  <view wx:if="{{chapterIndex > 0}}" class="reader-chapter-heading">
    <text class="reader-chapter-kicker">{{pageMeta || (chapters[chapterIndex].path === 'intro.html' ? '导读' : title)}}</text>
    <text class="offline-book-title">{{chapters[chapterIndex].title}}</text>
  </view>
  <view wx:if="{{audioPath}}" class="offline-player">
    <button size="mini" bindtap="toggleOfflineAudio">{{playing ? '暂停' : '听本章'}}</button>
    <slider wx:if="{{audioDuration}}" value="{{audioTime}}" max="{{audioDuration}}" bindchange="seekOfflineAudio" />
  </view>
  <view wx:if="{{offline && missingChapterAudio}}" class="offline-block">本章音频未下载</view>
  <view wx:for="{{blocks}}" wx:key="index" class="offline-block">
    <image wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" class="offline-image" />
    <text wx:elif="{{item.missingImage}}">这张插图未下载</text>
    <rich-text wx:else nodes="{{item.text}}"></rich-text>
  </view>
  <view wx:if="{{chapterIndex === 0 && chapters.length > 1}}" class="reader-directory" style="--reader-chapter-tint: {{pageIndex.tint || '#f0e6d4'}};">
    <text class="reader-directory-title">目录</text>
    <block wx:if="{{pageIndex}}">
      <view wx:for="{{pageIndex.entries}}" wx:key="path" class="reader-directory-row" hover-class="reader-chapter-pressed" hover-start-time="0" data-index="{{item.position}}" bindtap="openChapter">
        <text class="reader-directory-number">{{item.number}}</text>
        <view class="reader-directory-copy">
          <text>{{item.title}}</text><text wx:if="{{item.brief}}" class="reader-directory-brief">{{item.brief}}</text>
        </view>
        <text class="reader-directory-read">读 →</text>
      </view>
    </block>
    <block wx:else>
    <button wx:for="{{chapters}}" wx:key="path" class="reader-chapter-link" hover-class="reader-chapter-pressed" hover-start-time="0" hidden="{{index === 0}}"
      data-index="{{index}}" bindtap="openChapter">{{item.title}} <text aria-hidden="true">›</text></button>
    </block>
  </view>
  <view wx:if="{{chapters.length}}" class="offline-chapter-nav">
    <button size="mini" disabled="{{chapterIndex === 0}}" data-step="-1" bindtap="stepOfflineChapter">上一页</button>
    <button wx:if="{{chapterIndex > 0}}" size="mini" data-index="0" bindtap="openChapter">目录</button>
    <button size="mini" disabled="{{chapterIndex + 1 === chapters.length}}" data-step="1" bindtap="stepOfflineChapter">下一页</button>
  </view>
  </view>
  </scroll-view>
</view>
<cover-view wx:if="{{loading}}" class="reader-loading">
  <cover-view class="reader-loading-card">
    <cover-view class="reader-loading-spinner"></cover-view>
    <cover-view class="reader-loading-copy">{{i18n["加载中…"]}}</cover-view>
  </cover-view>
</cover-view>

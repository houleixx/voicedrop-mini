@import '../../styles/remixicon.wxss';

.community-detail-screen {
  min-height: 100vh;
  padding: 0 32rpx 72rpx;
  background: #fbf7f0;
}

.detail-toolbar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  padding: 0 15rpx 0 32rpx;
  align-items: center;
  justify-content: space-between;
  background: #fbf7f0;
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 0;
}

.tool-button {
  display: flex;
  width: 32px;
  height: 32px;
  min-width: 32px;
  max-width: 32px;
  min-height: 32px;
  max-height: 32px;
  margin: 0;
  padding: 0;
  flex: 0 0 32px;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(224, 216, 204, 0.72);
  border-radius: 8px;
  color: #2a2521;
  background: #fffdf9;
  box-shadow: 0 6rpx 18rpx rgba(65, 52, 41, 0.1);
}

.back-icon {
  display: flex;
  width: 32px;
  height: 32px;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(224, 216, 204, 0.72);
  border-radius: 8px;
  color: #2a2521;
  background: #fffdf9;
  box-shadow: 0 6rpx 18rpx rgba(65, 52, 41, 0.1);
  font-size: 20px;
  font-weight: 700;
  line-height: 32px;
  text-align: center;
}

.back-button {
  margin-left: -5px;
  width: 44px;
  height: 44px;
  min-width: 44px;
  max-width: 44px;
  min-height: 44px;
  max-height: 44px;
  flex: 0 0 44px;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.more-icon {
  width: 21px;
  height: 21px;
  color: #2a2521;
  font-size: 21px;
  font-weight: 700;
  line-height: 21px;
  text-align: center;
}

.more-button {
  margin-left: 11px;
}

.detail-body {
  min-height: 100vh;
}

.article-head {
  padding: 0 0 20rpx;
}

.article-title {
  display: block;
  color: #2a2521;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.28;
}

.ai-generated-label {
  display: inline-flex;
  min-height: 38rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  padding: 4rpx 14rpx;
  align-items: center;
  border: 1rpx solid #ebc6b9;
  border-radius: 999rpx;
  color: #d8593b;
  background: #f6e4dc;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

.ai-generated-row {
  display: flex;
  margin-top: 16rpx;
  justify-content: flex-end;
}

.ai-generated-row .ai-generated-label {
  margin-top: 0;
}

.article,
.empty {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.paragraph {
  display: block;
  margin-bottom: 30rpx;
  color: #514b44;
  font-size: 35rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.markdown-h1 .paragraph { color: #2a2521; font-size: 44rpx; font-weight: 800; line-height: 1.45; }
.markdown-h2 .paragraph { color: #2a2521; font-size: 38rpx; font-weight: 700; line-height: 1.5; }
.markdown-h3 .paragraph { color: #2a2521; font-size: 34rpx; font-weight: 700; line-height: 1.55; }
.markdown-marker { color: #d8593b; font-weight: 700; }
.markdown-quote { padding-left: 24rpx; border-left: 6rpx solid rgba(216, 89, 59, 0.45); }
.markdown-quote .paragraph { color: #8a8175; }
.markdown-divider { height: 2rpx; margin: 16rpx 0 30rpx; background: #ece3d5; }

.photo-block {
  position: relative;
  min-height: 180rpx;
  margin: 20rpx 0 28rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f1e7da;
}

.article-image {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  background: #f1e7da;
}

.loading-card {
  display: flex;
  min-height: 160rpx;
  padding: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #9b8f7f;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.empty {
  color: #82786d;
  font-size: 30rpx;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #efe8dd;
  border-top-color: #c7432f;
  border-radius: 50%;
  animation: loading-spin 0.8s linear infinite;
}

.more-menu-layer {
  position: fixed;
  inset: 0;
  z-index: 30;
}

.more-menu-card {
  position: absolute;
  right: 24rpx;
  width: 260rpx;
  overflow: hidden;
  border: 1rpx solid rgba(220, 210, 196, 0.72);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 18rpx 44rpx rgba(65, 52, 41, 0.16);
}

.more-menu-row {
  position: relative;
  display: flex;
  height: 88rpx;
  padding: 0 30rpx;
  align-items: center;
  color: #2a2521;
  font-size: 31rpx;
  line-height: 88rpx;
}

.more-menu-label {
  flex: 1;
}

.more-menu-icon {
  width: 42rpx;
  color: #d8593b;
  font-size: 40rpx;
  text-align: center;
}

.more-menu-share-button {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.more-menu-share-button::after {
  border: 0;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}

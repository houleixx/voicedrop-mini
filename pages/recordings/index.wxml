<template name="community-card">
  <view class="community-card {{item.coverPhotoUrl ? 'has-photo' : item.paletteClass}}"
        data-share-id="{{item.shareId}}" bindtap="openPost" bindlongpress="confirmCommunityUnshare">
    <image wx:if="{{item.coverPhotoUrl}}" class="community-card-image"
           src="{{item.coverPhotoUrl}}" mode="widthFix" lazy-load
           data-cover-key="{{item.coverPhotoKey}}" data-share-id="{{item.shareId}}" bindload="onCommunityCoverLoad" binderror="onCommunityCoverError" />
    <view class="community-card-body">
      <view wx:if="{{item.isPrompt}}" class="community-prompt-badge">提示词</view>
      <view wx:if="{{item.isReply}}" class="community-reply-badge">
        <view class="community-reply-badge-icon community-reply-icon-accent"></view>
        <text>回应</text>
      </view>
      <text class="community-card-title">{{item.title || '(无题)'}}</text>
      <text wx:if="{{item.preview && !item.coverPhotoUrl}}" class="community-card-preview">{{item.preview}}</text>
      <view class="community-card-meta">
        <text class="community-avatar" style="background: {{item.avatarColor}};">{{item.authorInitial}}</text>
        <text class="community-author">{{item.authorDisplay}}</text>
        <view class="community-count community-like-count">
          <text class="community-like-icon ri-heart-fill"></text>
          <text>{{item.likeCount}}</text>
        </view>
        <view wx:if="{{item.replyCount > 0}}" class="community-count community-reply-count">
          <text class="community-reply-icon ri-chat-2-line"></text>
          <text>{{item.replyCount}}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="screen recording-screen">
  <home-tabs id="home-tabs" current="{{currentHomeTab}}" tabs="{{homeTabs}}" bind:change="switchHomeTab" bind:settings="openSettings" />

  <view wx:if="{{activeTab === 'community'}}" class="community-feed-tabs" style="top: {{scrollContentTop}}px;">
    <block wx:if="{{!communitySearching}}">
    <view class="community-feed-tab {{communityFeedTab === 'recommended' ? 'active' : ''}}"
          data-feed-tab="recommended" bindtap="selectCommunityFeed"><text class="community-feed-tab-label">推荐</text></view>
    <view class="community-feed-tab {{communityFeedTab === 'latest' ? 'active' : ''}}"
          data-feed-tab="latest" bindtap="selectCommunityFeed"><text class="community-feed-tab-label">最新</text></view>
    <view class="community-feed-tab {{communityFeedTab === 'replies' ? 'active' : ''}}"
          data-feed-tab="replies" bindtap="selectCommunityFeed"><text class="community-feed-tab-label">回应</text></view>
    <view class="community-search-spacer"></view>
    <view class="community-search-button ri-search-line" bindtap="openCommunitySearch" aria-label="搜索社区"></view>
    </block>
    <block wx:else>
      <view class="community-search-slot">
        <view class="community-search-box">
          <text class="ri-search-line community-search-leading"></text>
          <input class="community-search-input" value="{{communitySearchQuery}}" placeholder="搜索标题、作者或内容"
                 focus bindinput="onCommunitySearchInput" confirm-type="search" />
        </view>
      </view>
      <view class="community-search-cancel-slot" bindtap="closeCommunitySearch">
        <text class="community-search-cancel-label">取消</text>
      </view>
    </block>
  </view>

  <scroll-view
    class="scroll-content"
    scroll-y
    enhanced="{{true}}"
    bounces="{{true}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    refresher-default-style="none"
    refresher-threshold="72"
    refresher-background="#faf6ef"
    bindrefresherrefresh="onRefresherRefresh"
    scroll-top="{{scrollTop}}"
    bindscroll="onScroll"
    style="top: {{activeTab === 'community' ? communityScrollContentTop : scrollContentTop}}px;"
    bindtouchstart="onScreenTouchStart"
  >
    <view slot="refresher" class="pull-refresh-indicator">
      <view class="loading-spinner pull-refresh-spinner" aria-hidden="true"></view>
    </view>
    <view class="scroll-inner {{activeTab === 'recordings' ? 'with-record-dock' : ''}}">
    <block wx:if="{{activeTab === 'recordings'}}">
      <view wx:if="{{error}}" class="notice">{{error}}</view>
      <view wx:elif="{{loading}}" class="notice loading-notice">
        <view class="loading-spinner" aria-hidden="true"></view>
        <text>加载中...</text>
      </view>

      <view wx:if="{{!loading && !error && records.length === 0}}" class="empty card">
        <text class="empty-title">还没有录音</text>
        <text class="empty-sub">{{selectedTag ? '当前标签还没有录音。' : '录一段话，VoiceDrop 会把它整理成文章。'}}</text>
      </view>

      <view class="list" wx:if="{{!loading && !error && records.length > 0}}">
        <view class="record-row" wx:for="{{records}}" wx:key="stem"
              bindtouchstart="onRowTouchStart"
              bindtouchmove="onRowTouchMove"
              bindtouchend="onRowTouchEnd"
              data-index="{{index}}">
          <view class="record-card {{item.isEmpty ? 'silent' : ''}}" style="transform: translateX({{item._translateX || 0}}px);" data-index="{{index}}" bindtap="openDetail">
            <view class="record-icon-wrapper {{item.coverPhotoIsBook && item.coverPhotoLoaded ? 'book-cover' : ''}}">
              <view wx:if="{{!item.coverPhotoUrl || (item.coverPhotoIsBook && !item.coverPhotoLoaded)}}" class="record-icon" aria-hidden="true">
                <view class="record-wave">
                  <view class="record-wave-line record-wave-line-short"></view>
                  <view class="record-wave-line record-wave-line-tall"></view>
                  <view class="record-wave-line record-wave-line-mid record-wave-line-last"></view>
                </view>
              </view>
              <image wx:if="{{item.coverPhotoUrl}}" class="record-cover {{item.coverPhotoIsBook ? 'book-cover-image' : ''}} {{item.coverPhotoIsBook && !item.coverPhotoLoaded ? 'record-cover-preloading' : ''}}"
                     src="{{item.coverPhotoUrl}}" mode="aspectFill" lazy-load
                     data-stem="{{item.stem}}" data-url="{{item.coverPhotoUrl}}"
                     bindload="onRecordCoverLoad" binderror="onRecordCoverError" />
              <view wx:if="{{commandTalking && item._commandRef}}" class="command-badge">
                {{item._commandRef}}
              </view>
            </view>
            <view class="record-main">
              <text class="record-name">{{item.rowTitle}}</text>
              <view class="record-meta">
                <text>{{item.timeLabel || item.uploaded || '上传中'}}</text>
                <text class="duration">{{item.durationLabel || '音频'}}</text>
                <text class="status-dot {{item.statusColor}}"></text>
                <text class="status {{item.statusColor}}">{{item.statusLabel}}</text>
              </view>
            </view>
            <text class="chevron ri-arrow-right-s-line" aria-hidden="true"></text>
          </view>
          <view class="delete-btn" data-index="{{index}}" bindtap="confirmDelete">删除</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'community'}}">
      <view wx:if="{{communityError}}" class="notice">{{communityError}}</view>
      <view wx:elif="{{communityLoading || !communityLoaded}}" class="notice loading-notice">
        <view class="loading-spinner" aria-hidden="true"></view>
        <text>正在加载...</text>
      </view>
      <view wx:elif="{{communityPosts.length === 0}}" class="empty card">
        <text class="empty-title">社区暂无文章</text>
        <text class="empty-sub">稍后刷新，或先分享自己的文章。</text>
      </view>

      <view wx:else class="community-post-list">
        <view class="community-post-column">
          <block wx:for="{{communityLeftPosts}}" wx:key="shareId">
            <template is="community-card" data="{{item: item}}" />
          </block>
        </view>
        <view class="community-post-column">
          <block wx:for="{{communityRightPosts}}" wx:key="shareId">
            <template is="community-card" data="{{item: item}}" />
          </block>
        </view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'books'}}">
      <view wx:if="{{booksError && !bookItems.length}}" class="shelf-state">{{booksError}}</view>
      <view wx:elif="{{!booksLoaded && !bookItems.length}}" class="shelf-state loading-notice">
        <view class="loading-spinner" aria-hidden="true"></view>
        <text>正在整理书架…</text>
      </view>
      <view wx:else class="shelf-rows books-shelf-inner">
        <view class="shelf-row-group" wx:for="{{bookRows}}" wx:key="index" wx:for-item="row">
          <view class="shelf-row">
            <block wx:for="{{row}}" wx:key="key" wx:for-item="cell">
              <view wx:if="{{cell.kind === 'write'}}" class="shelf-cell write-cell" bindtap="writeBook">
                <view class="book-cover write-cover"><view class="write-plus">＋</view><text class="write-label">写书</text></view>
                <view class="book-caption-stack"><text class="book-caption">写一本新书</text><text class="book-meta"> </text></view>
              </view>
              <view wx:else class="shelf-cell" data-slug="{{cell.slug}}" bindtap="openBook">
                <view class="book-cover cloth" style="background: radial-gradient(circle at 25% 15%, rgba(255,255,255,.10), rgba(255,255,255,0) 64%), linear-gradient(145deg, {{cell.c}}, {{cell.c2}});">
                  <text class="cover-main">{{cell.main}}</text><view class="cover-rule"></view><text wx:if="{{cell.sub}}" class="cover-sub">{{cell.sub}}</text>
                  <image wx:if="{{cell.coverDisplayUrl}}" class="cover-image" src="{{cell.coverDisplayUrl}}" mode="aspectFill" data-slug="{{cell.slug}}" binderror="onBookCoverError" />
                  <button wx:if="{{cell.editableByAuthor}}" class="book-revise" hover-class="book-revise-active" data-slug="{{cell.slug}}" catchtap="reviseBook" aria-label="修改{{cell.main}}"><text class="ri-edit-line"></text></button>
                </view>
                <view class="book-caption-stack"><text class="book-caption">{{cell.main}}</text><text class="book-meta">{{cell.chapters ? cell.chapters + ' 章' : (cell.sub || ' ')}}</text></view>
              </view>
            </block>
            <view wx:if="{{row.length === 1}}" class="shelf-cell shelf-cell-placeholder"></view>
          </view>
          <view class="shelf-bar"></view>
        </view>
      </view>
    </block>
    </view>
  </scroll-view>

  <view wx:if="{{activeTab === 'recordings'}}" class="record-dock">
    <!-- iOS VoiceFeedbackStack colors: transcript / queue / reply / error -->
    <view wx:if="{{commandStatusText}}" class="fab-status {{commandStatusKind}}">
      {{commandStatusText}}
    </view>

    <view class="mic-button-wrapper {{commandTalking ? 'talking' : ''}} {{commandCanceled ? 'canceled' : ''}}">
      <view class="mic-button {{recording ? 'recording' : ''}}"
            bindtouchstart="onMicTouchStart"
            bindtouchmove="onMicTouchMove"
            bindtouchend="onMicTouchEnd"
            bindtouchcancel="onMicTouchCancel"
            aria-label="{{recording ? '停止录音' : '开始录音'}}">
        <view class="mic-icon">
          <view class="mic-head"></view>
          <view class="mic-stand"></view>
          <view class="mic-base"></view>
        </view>
      </view>
    </view>

    <!-- Hint text below button (Android: fabLabel) -->
    <text class="dock-hint {{commandTalking ? 'talking' : ''}} {{commandCanceled ? 'canceled' : ''}}">{{dockHint}}</text>
  </view>
  <audio-consent-dialog
    visible="{{audioConsentVisible}}"
    bind:agree="onAudioConsentAgree"
    bind:decline="onAudioConsentDecline"
    bind:viewagreement="onAudioConsentViewAgreement"
  />

  <view wx:if="{{linkRequest}}" class="device-link-layer" catchtouchmove="preventDeviceLinkTouchMove">
    <view class="device-link-dialog" role="dialog" aria-label="设备登录请求">
      <text class="device-link-title">有新设备想登录你的账号</text>
      <text class="device-link-summary">在新设备上输入下面的验证码</text>

      <text class="device-link-code" aria-label="验证码 {{linkRequest.code}}">{{linkRequest.code}}</text>

      <text class="device-link-note">不是你本人操作？点「不是我」。</text>

      <view class="device-link-actions">
        <button class="device-link-button device-link-reject" bindtap="rejectDeviceLink">不是我</button>
        <button class="device-link-button device-link-confirm" bindtap="acknowledgeDeviceLink">这是我</button>
      </view>
    </view>
  </view>
</view>

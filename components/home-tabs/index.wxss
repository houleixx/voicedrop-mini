@import '../../styles/remixicon.wxss';

.home-head {
  position: relative;
  display: flex;
  width: 100%;
  box-sizing: border-box;
  padding-left: 44rpx;
  padding-right: 44rpx;
  align-items: flex-start;
  justify-content: flex-start;
  background: #faf6ef;
}

.brand-row {
  display: flex;
  min-height: 60px;
  align-items: center;
  flex: 1;
}

.brand-wave {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  align-items: center;
  justify-content: center;
}

.brand-wave-image {
  width: 39rpx;
  height: 32rpx;
}

.brand-name {
  color: #746d63;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.settings-button {
  position: absolute;
  display: flex;
  width: 44px;
  height: 44px;
  min-width: 44px;
  max-width: 44px;
  min-height: 44px;
  max-height: 44px;
  align-items: flex-start;
  justify-content: flex-end;
  background: transparent;
}

.settings-button-surface {
  display: flex;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #eee7dd;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(54, 46, 38, 0.1);
}

.settings-icon {
  width: 44rpx;
  height: 44rpx;
  color: #2a2521;
  font-family: 'remixicon' !important;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.settings-icon-gear::before {
  content: "\f0e8";
}

.section-tabs {
  width: 100%;
  box-sizing: border-box;
  margin-top: -8rpx;
  padding-left: 44rpx;
  padding-right: 44rpx;
  background: #faf6ef;
  white-space: nowrap;
}

.section-tabs-inner {
  display: inline-flex;
  min-width: 100%;
  align-items: flex-start;
  gap: 40rpx;
  justify-content: flex-start;
}

.section-tab {
  display: flex;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  padding: 6rpx 0 8rpx;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  color: #2a2521;
  line-height: 1;
  text-align: left;
}

.section-tab-text {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 48rpx;
  white-space: nowrap;
}

.section-tab-line {
  width: 100%;
  height: 6rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #e9332c;
}

.muted-tab {
  color: #756f66;
}

.muted-tab .section-tab-text {
  font-weight: 700;
}

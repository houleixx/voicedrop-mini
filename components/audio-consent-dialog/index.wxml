<view wx:if="{{visible}}" class="consent-layer" catchtouchmove="preventTouchMove">
  <view class="consent-card" role="dialog" aria-label="{{i18n['音频信息授权']}}">
    <text class="consent-title">{{i18n["音频信息授权"]}}</text>
    <text class="consent-summary">{{summary}}</text>
    <text class="consent-note">{{i18n["我们不会提取声纹模板，也不会使用音频进行声纹身份识别。"]}}</text>
    <button class="agreement-link" bindtap="viewAgreement">{{i18n["查看完整协议"]}}</button>
    <view class="consent-actions">
      <button class="decline-button" bindtap="decline">{{i18n["不同意"]}}</button>
      <button class="agree-button" bindtap="agree">{{i18n["同意并继续"]}}</button>
    </view>
  </view>
</view>

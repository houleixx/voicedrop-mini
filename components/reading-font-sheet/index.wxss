.font-sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(42, 37, 33, 0.06);
  animation: font-sheet-fade-in 240ms ease-out both;
}
.font-sheet-panel {
  position: relative;
  width: 100%;
  max-height: 72vh;
  box-sizing: border-box;
  padding: 28rpx 48rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 18rpx 18rpx 0 0;
  background: #fffaf4;
  box-shadow: 0 -14rpx 42rpx rgba(65, 52, 41, 0.14);
  animation: font-sheet-slide-in 240ms ease-out both;
}
.font-sheet-head {
  position: relative;
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #ece3d5;
}
.font-sheet-title {
  padding: 0 76rpx;
  color: #24211d;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
  text-align: center;
}
.font-sheet-close {
  position: absolute;
  top: 0;
  right: -20rpx;
  display: flex;
  width: 84rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #7f7770;
  font-size: 36rpx;
  line-height: 1;
}
.font-sheet-close-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}
.font-sheet-close-icon::before, .font-sheet-close-icon::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 0;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #7f7770;
  transform: rotate(45deg);
}
.font-sheet-close-icon::after { transform: rotate(-45deg); }
.font-sheet-list {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 564rpx;
  max-height: 48vh;
}
.font-sheet-row {
  display: flex;
  width: 100%;
  height: 112rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: space-between;
  border-radius: 0;
  background: transparent;
  color: #2a2521;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1.4;
  text-align: left;
}
.font-sheet-row + .font-sheet-row { border-top: 1rpx solid #ece3d5; }
.font-sheet-check {
  flex-shrink: 0;
  width: 16rpx;
  height: 30rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  border-right: 4rpx solid #d8593b;
  border-bottom: 4rpx solid #d8593b;
  transform: rotate(45deg);
}
.closing { animation: font-sheet-fade-out 180ms ease-in both; }
.closing .font-sheet-panel { animation: font-sheet-slide-out 180ms ease-in both; }
@keyframes font-sheet-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes font-sheet-fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes font-sheet-slide-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes font-sheet-slide-out { from { transform: translateY(0); } to { transform: translateY(100%); } }

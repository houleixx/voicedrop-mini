@import '../../styles/remixicon.wxss';

.page-header {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 100;
  padding-top: 0;
  padding-right: 32rpx;
  padding-bottom: 0;
  background: #faf6ef;
}

.header-back {
  position: absolute;
  left: calc(32rpx - 5px);
  bottom: calc(24rpx - 6px);
  z-index: 1;
  display: flex;
  width: 44px;
  height: 44px;
  min-width: 44px;
  max-width: 44px;
  min-height: 44px;
  max-height: 44px;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: transparent;
  flex-shrink: 0;
}

.header-back-surface {
  display: flex;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(224, 216, 204, 0.72);
  border-radius: 8px;
  background: #fffdf9;
  box-shadow: 0 6rpx 18rpx rgba(65, 52, 41, 0.1);
}

.header-back:active .header-back-surface {
  background: #eadccd;
}

.header-left {
  position: absolute;
  left: 32rpx;
  bottom: 24rpx;
  z-index: 1;
  display: flex;
  height: 64rpx;
  align-items: center;
}

.header-back-icon {
  width: 32px;
  height: 32px;
  color: #2a2521;
  font-family: 'remixicon' !important;
  font-size: 20px;
  font-weight: 700;
  line-height: 32px;
  text-align: center;
}

.header-back-icon-arrow::before {
  content: "\ea64";
}

.header-spacer {
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  min-height: 64rpx;
  max-height: 64rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  background: transparent;
  flex-shrink: 0;
}

.header-title {
  position: absolute;
  left: 128rpx;
  right: 128rpx;
  bottom: 24rpx;
  height: 64rpx;
  min-width: 0;
  line-height: 64rpx;
  text-align: center;
  color: #2a2521;
  font-size: 36rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-title.title-left {
  right: auto;
  width: 300rpx;
  text-align: left;
}

.header-right {
  position: absolute;
  right: 32rpx;
  bottom: 24rpx;
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  min-width: 64rpx;
}
